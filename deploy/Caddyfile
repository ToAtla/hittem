# Hittem static hosting. Install to /etc/caddy/Caddyfile on the VM.
#
# Caddy obtains and renews Let's Encrypt certificates on its own. That needs the
# DNS records for both names already pointing at this host and ports 80 and 443
# reachable, so point DNS first and install this second, or the first certificate
# request fails and Caddy backs off.

www.hittem.site {
	redir https://hittem.site{uri} permanent
}

hittem.site {
	root * /srv/hittem
	encode zstd gzip
	file_server

	header {
		# The app has no build step, so filenames are stable (app.js, styles.css).
		# Any positive max-age would pin a stale build until it expired. "no-cache"
		# still stores the response, it just forces revalidation, so ETags make
		# repeat loads cheap while updates land immediately. Offline support comes
		# from the service worker, not from the HTTP cache.
		#
		# service-worker.js in particular must never be served from cache: a pinned
		# worker keeps serving its own stale bundle and the app stops updating at all.
		Cache-Control "no-cache"

		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"

		# Sign-in pulls the Google Identity Services script and talks to the People
		# API, so those origins have to be allowed explicitly. 'unsafe-inline' under
		# style-src covers the inline style attributes the card stack sets for its
		# transforms; there are no inline <script> blocks, so script-src stays strict.
		#
		# If sign-in ever breaks with a CSP violation in the console, comment this
		# single line out to confirm, then widen the offending directive.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com https://people.googleapis.com https://www.googleapis.com; frame-src https://accounts.google.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; object-src 'none'"

		-Server
	}

	# Go's MIME table does not reliably carry .webmanifest, and a wrong type makes
	# iOS quietly refuse the install-to-home-screen metadata.
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"
}
